# Copy to .env to override defaults. Every value below already has a working default,
# so `docker compose up` runs without a .env file.

# --- Public entrypoint (Caddy) ---
HTTP_PORT=8080

# --- Database / cache (used by the server and worker) ---
POSTGRES_USER=sudoku
POSTGRES_PASSWORD=sudoku
POSTGRES_DB=sudoku
# Local development outside Docker (pnpm dev):
DATABASE_URL=postgres://sudoku:sudoku@localhost:5432/sudoku
REDIS_URL=redis://localhost:6379

# --- Server ---
PORT=3000
LOG_LEVEL=info
# Origin the browser uses. Only needed when the web app is served from a different origin.
PUBLIC_ORIGIN=http://localhost:5173
# Set to true behind HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
# Bearer token for /api/v1/admin/* (anti-cheat review). Empty disables the admin API.
ADMIN_TOKEN=

# --- Game tuning ---
BOT_FALLBACK_MS=5000
MATCH_TIME_LIMIT_MS=900000
TOURNAMENT_FILL_MS=60000
PUZZLE_POOL_TARGET=300
