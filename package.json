{
  "name": "sudoku-world-cup",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time multiplayer Sudoku with a World Cup twist: 1v1 races, human-like bots, 16-player knockout tournaments and a global country leaderboard.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @swcup/server db:generate",
    "db:migrate": "pnpm --filter @swcup/server db:migrate",
    "db:seed": "pnpm --filter @swcup/server db:seed",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
