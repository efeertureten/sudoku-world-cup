{
	# Plain HTTP inside the container. Put a TLS-terminating proxy in front,
	# or replace ":8080" with your domain to let Caddy fetch certificates.
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	# API and WebSocket traffic share the page's origin, so the session
	# cookie authenticates both without any CORS configuration.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:server:3000}
	}
	handle /socket.io/* {
		reverse_proxy {$API_UPSTREAM:server:3000}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
