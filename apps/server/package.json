{
  "name": "@swcup/server",
  "version": "0.1.0",
  "private": true,
  "description": "Express + Socket.io game server: matchmaking, server-authoritative matches, bots, tournaments and leaderboards.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli.ts seed"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@socket.io/redis-adapter": "8.3.0",
    "@swcup/engine": "workspace:*",
    "@swcup/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
